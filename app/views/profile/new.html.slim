.container.mt-4
  .row.justify-content-center
    .col-md-8
      .card
        .card-header
          h1.mb-0 = t('bulletins.new.title')
        .card-body
          = simple_form_for @bulletin, url: profile_index_path, html: { class: 'needs-validation', novalidate: true } do |f|
            = f.error_notification class: 'alert alert-danger'
            = f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present?

            .mb-3
              = f.input :title,
                      label: t('bulletins.new.labels.title'),
                      wrapper: false,
                      input_html: { class: 'form-control' },
                      label_html: { class: 'form-label' }

            .mb-3
              = f.input :description,
                      as: :text,
                      label: t('bulletins.new.labels.description'),
                      wrapper: false,
                      input_html: { rows: 5, class: 'form-control' },
                      label_html: { class: 'form-label' }

            .mb-3
              = f.association :category,
                      label: t('bulletins.new.labels.category'),
                      wrapper: false,
                      input_html: { class: 'form-select' },
                      label_html: { class: 'form-label' },
                      prompt: t('bulletins.new.prompts.category')

            .mb-3
              = f.input :image,
                      as: :file,
                      label: t('bulletins.new.labels.image'),
                      wrapper: false,
                      input_html: { accept: 'image/png,image/jpg,image/jpeg', class: 'form-control' },
                      label_html: { class: 'form-label' },
                      hint: t('bulletins.new.hints.image')

            .d-flex.justify-content-between
              = f.button :submit, t('bulletins.new.buttons.submit'), class: 'btn btn-primary'
              = link_to t('bulletins.new.buttons.cancel'), root_path, class: 'btn btn-secondary'