.container-fluid.mt-5
  .row
    .col-md-4
    .col-md-4

      h3 = I18n.t('users.new.title')

      = simple_form_for @user, url: users_path, html: { class: 'needs-validation' } do |f|
        .mb-3
          = f.input :email,
                  label_html: { class: 'form-label' },
                  wrapper_html: { class: 'mb-2' },
                  input_html: { class: 'form-control', required: true }

        .mb-3
          = f.input :password,
                  label_html: { class: 'form-label' },
                  wrapper_html: { class: 'mb-2' },
                  input_html: { class: 'form-control', required: true, placeholder: I18n.t('users.new.label_password_placeholder') }

        .mb-3
          = f.input :password_confirmation,
                  label_html: { class: 'form-label' },
                  wrapper_html: { class: 'mb-2' },
                  input_html: { class: 'form-control', required: true }

        .text-end
          = f.button :submit, I18n.t('users.new.submit'),
                  class: 'btn btn-lg w-100'
