.container-fluid.mt-5
  .row
    .col-md-4
    .col-md-4

      h3 = I18n.t('sessions.new.title')

      = simple_form_for :session, url: sessions_path, method: :post, html: { class: 'needs-validation' } do |f|
        .mb-3
          = f.input :email,
                  label: false,
                  wrapper_html: { class: 'mb-2' },
                  input_html: { class: 'form-control', required: true, placeholder: I18n.t('sessions.new.email_placeholder'), autocomplete: 'email' }

        .mb-3
          = f.input :password,
                  label: false,
                  wrapper_html: { class: 'mb-2' },
                  input_html: { class: 'form-control', required: true, placeholder: I18n.t('sessions.new.password_placeholder'), autocomplete: 'current-password' }

        .text-end
          = f.button :submit, I18n.t('sessions.new.submit'),
                  class: 'btn btn-lg w-100'
