.col-sm-6.col-md-4.col-lg-3.mb-4
  .card.shadow-sm.h-100
    - if bulletin.image.attached?
      = image_tag bulletin.thumbnail,
              class: 'card-img-top',
              style: 'height: 225px; width: 100%; object-fit: cover;'
    - else
      .bg-secondary.d-flex.align-items-center.justify-content-center style="height: 225px;"
        svg.bd-placeholder-img.card-img-top width="100%" height="225" xmlns="http://www.w3.org/2000/svg" role="img" preserveAspectRatio="xMidYMid slice" focusable="false"
          title Placeholder
          rect width="100%" height="100%" fill="#55595c"
          text x="50%" y="50%" fill="#eceeef" dy=".3em" text-anchor="middle"
            = I18n.t('bulletins.bulletin.no_image')

    .card-body.d-flex.flex-column
      = link_to bulletin.title, bulletin_path(bulletin), class: ''
      small.text-body-secondary
        = l(bulletin.created_at, format: :short)