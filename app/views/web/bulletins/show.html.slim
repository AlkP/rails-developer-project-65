.container.mt-4
  .row
    .col-lg-8.mx-auto
      .card.shadow-sm
        / Заголовок
        .card-header.bg-transparent
          h1.mb-0 = @bulletin.title
          small.text-muted
            = @bulletin.created_at.strftime("%d.%m.%Y")
            |  • #{@bulletin.category.name}
            |  • #{@bulletin.user.email}

        / Изображение
        - if @bulletin.image.attached?
          = image_tag @bulletin.image, class: 'img-fluid w-100', style: 'max-height: 500px; object-fit: contain; background-color: #f8f9fa;'
        - else
          .bg-light.text-center.py-5
            span.text-muted = I18n.t('bulletins.index.no_image')

        / Описание
        .card-body
          h5.h5.text-muted.mb-3 Описание
          p.lead = @bulletin.description

        / Мета-информация
        .card-footer.bg-transparent
          .d-flex.justify-content-between.align-items-center
            .btn-group
              = link_to 'Назад', bulletins_path, class: 'btn btn-outline-secondary'
            small.text-muted
              | ID: ##{@bulletin.id}
