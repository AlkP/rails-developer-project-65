.container
  .row.justify-content-center
    .col-md-6
      = simple_form_for [:admin, @category] do |f|
        = f.error_notification

        .mb-3
          = f.input :name,
                  label: false,
                  placeholder: t('admin.categories.form.name_placeholder'),
                  input_html: { class: 'form-control' }

        .d-flex.gap-2
          = f.button :submit, t('admin.categories.form.submit'), class: 'btn btn-primary'
          = link_to t('admin.categories.form.cancel'), admin_categories_path, class: 'btn btn-outline-secondary'
